rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Food Preservation Lab (safe edition) — shared by Lesson 1 and Lesson 2.
    // Classroom model: any signed-in user (anonymous auth) in a class may
    // read the roster and write their own student document. Suitable for a
    // single-school classroom tool. Tighten later if you add real accounts.
    // PRIVACY: students join with an anonymous code only. No real names are
    // ever stored; we require an anonymous `code2` string below and
    // deliberately do NOT accept a real name field.

    match /sessions/{code} {
      // session metadata: anyone signed in can read; create/update allowed
      // (teacher opens the class, students "merge" it on join).
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /students/{studentId} {
        // Everyone signed in can read the class roster (teacher dashboard).
        allow read: if request.auth != null;
        // A student may create/update their own progress doc, keyed by their
        // anonymous entry code. PRIVACY: we require an anonymous `code2` string
        // and deliberately do NOT accept a real name field.
        allow create, update: if request.auth != null
          && request.resource.data.code2 is string
          && request.resource.data.code2.size() <= 20;
        // Allow the teacher to delete a student entry (e.g. remove a duplicate).
        // Any signed-in user in the class may delete; suitable for a single-school
        // classroom tool. Tighten later if you add real teacher accounts.
        allow delete: if request.auth != null;
      }
    }
  }
}
